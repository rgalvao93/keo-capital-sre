# Datadog
DD_API_KEY=your-datadog-api-key
DD_APP_KEY=your-datadog-app-key
DD_SITE=datadoghq.com

# Terraform / Datadog provider
TF_VAR_datadog_api_key=your-datadog-api-key
TF_VAR_datadog_app_key=your-datadog-app-key
TF_VAR_datadog_api_url=https://api.datadoghq.com/

# PagerDuty (optional)
TF_VAR_pagerduty_subdomain=your-subdomain
TF_VAR_pagerduty_api_token=your-pagerduty-api-token

# Slack (optional)
TF_VAR_slack_account_name=your-slack-account
